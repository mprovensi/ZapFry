extends RefCounted

const Profile = preload("res://scripts/player_profile.gd")


func run(check: Callable) -> void:
	var directory := "res://builds/profile_tests/run_%d" % Time.get_ticks_usec()
	DirAccess.make_dir_recursive_absolute(directory)
	var profile := Profile.new()
	check.call(profile.load_profile(directory + "/missing.cfg") == ERR_FILE_NOT_FOUND, "Perfil ausente inicia sem erro de dados")
	check.call(profile.unlocked_level == 0 and profile.completed_count() == 0, "Perfil novo libera somente a primeira fase")
	check.call(not profile.reduced_flashes, "Perfil novo usa flashes normais por padrão")
	check.call(profile.music_volume == 1 and profile.effects_volume == 1 and profile.vibration_enabled, "Novos ajustes mantêm o volume e a vibração anteriores por padrão")
	check.call(profile.record_win(1, 1400, 1, 70.0), "Vitória válida é registrada")
	profile.record_win(1, 1800, 3, 55.0)
	profile.record_win(1, 1500, 2, 65.0)
	var record := profile.level_record(1)
	check.call(record["best_score"] == 1800 and record["stars"] == 3 and record["best_time"] == 55.0, "Repetir preserva os melhores recordes individuais")
	check.call(record["completions"] == 3 and profile.unlocked_level == 1, "Vitórias contam sem bloquear fase já liberada")
	record["stars"] = 0
	check.call(profile.level_record(1)["stars"] == 3, "Consulta de recorde não expõe dados mutáveis")
	profile.record_win(2, 1600, 2, 40.0)
	check.call(profile.completed_count() == 2 and profile.total_stars() == 5, "Resumo de fases e estrelas é consistente")
	check.call(not profile.record_win(0, 1000, 3, 1) and not profile.record_win(25, 1000, 3, 1), "IDs inválidos não alteram progresso")
	check.call(not profile.record_win(3, 0, 3, 1) and not profile.record_win(3, 1000, 4, 1) and not profile.record_win(3, 1000, 3, -1), "Resultado inválido não é salvo")
	check.call(not profile.record_win(3, 1000, 3, INF), "Tempo infinito não é salvo")
	profile.sound_enabled = false
	profile.reduced_flashes = false
	profile.music_volume = 0.35
	profile.effects_volume = 0.65
	profile.vibration_enabled = false
	profile.appearance = {"level": 0, "id": "cavaleira", "name": "Zefa do Trovão", "palette": 0, "story": 0, "intro_seen": false}
	var path := directory + "/profile.cfg"
	check.call(profile.save_profile(path) == OK, "Perfil grava arquivo temporário e promove a versão completa")
	var restored := Profile.new()
	check.call(restored.load_profile(path) == OK, "Perfil salvo pode ser relido")
	check.call(restored.records == profile.records and restored.unlocked_level == 2 and restored.best_score == 1800, "Resultados sobrevivem ao reinício")
	check.call(restored.current_level == 2, "Ponto de continuação acompanha a fase seguinte e sobrevive ao reinício")
	check.call(restored.appearance == profile.appearance, "Aparência salva não depende de dados do tabuleiro")
	check.call(not restored.sound_enabled and not restored.reduced_flashes, "Preferências sobrevivem ao reinício")
	check.call(is_equal_approx(restored.music_volume, 0.35) and is_equal_approx(restored.effects_volume, 0.65) and not restored.vibration_enabled, "Volumes independentes e vibração sobrevivem ao reinício")
	profile.record_win(3, 1700, 2, 30.0)
	check.call(profile.save_profile(path) == OK and FileAccess.file_exists(path + ".bak"), "Gravação seguinte preserva cópia de segurança")
	var broken := FileAccess.open(path, FileAccess.WRITE)
	broken.store_string("[invalid]\nnot_a_profile=true\n")
	broken.close()
	var recovered := Profile.new()
	check.call(recovered.load_profile(path) == OK and recovered.loaded_from_backup, "Perfil corrompido recupera a cópia de segurança")
	check.call(recovered.level_record(1)["stars"] == 3 and recovered.unlocked_level == 2, "Cópia recuperada mantém os recordes anteriores")
	check.call(is_equal_approx(recovered.music_volume, 0.35) and not recovered.vibration_enabled, "Cópia de segurança recupera também os ajustes")
	check.call(recovered.save_profile(path) == OK, "Perfil recuperado pode ser salvo novamente")
	var healthy := Profile.new()
	check.call(healthy.load_profile(path) == OK and not healthy.loaded_from_backup, "Recuperação restaura um arquivo principal válido")
	healthy.record_win(4, 1800, 3, 22.0)
	check.call(healthy.save_profile(path) == OK, "Novos saves atualizam uma cópia de segurança já existente")
	# Formato existente no celular, anterior aos recordes por fase.
	var legacy := ConfigFile.new()
	legacy.set_value("preferences", "sound", false)
	legacy.set_value("preferences", "reduced_flashes", true)
	legacy.set_value("progress", "best_score", 2000)
	legacy.set_value("progress", "unlocked_level", 5)
	var legacy_path := directory + "/legacy.cfg"
	legacy.save(legacy_path)
	var migrated := Profile.new()
	check.call(migrated.load_profile(legacy_path) == OK, "Save antigo é importado")
	check.call(migrated.appearance.is_empty(), "Migração de perfil antigo mantém a escolha de personagem pendente")
	check.call(migrated.unlocked_level == 5 and migrated.completed_count() == 5, "Migração preserva os desbloqueios comprovados")
	check.call(migrated.current_level == 5, "Save antigo sem ponto de continuação mantém a próxima fase desbloqueada")
	check.call(migrated.music_volume == 1 and migrated.effects_volume == 1 and migrated.vibration_enabled, "Save anterior aos ajustes conserva a mixagem e a vibração")
	check.call(migrated.best_score == 2000 and not migrated.sound_enabled and migrated.reduced_flashes, "Migração preserva recorde global e preferências")
	check.call(migrated.has_legacy_records() and migrated.total_stars() == 0, "Migração não inventa estrelas antigas")
	check.call(migrated.level_record(1)["best_time"] == -1 and migrated.level_record(1)["best_score"] == 0, "Tempos e pontuações desconhecidos continuam desconhecidos")
	check.call(migrated.level_record(6).is_empty(), "Última fase liberada não é marcada como concluída sem evidência")
	migrated.record_win(1, 1000, 3, 4.0)
	check.call(not migrated.level_record(1)["legacy"] and migrated.level_record(1)["stars"] == 3, "Rejogar preenche um recorde migrado")
	check.call(migrated.save_profile(legacy_path) == OK, "Migração é persistida no formato atual")
	var reread := Profile.new()
	reread.load_profile(legacy_path)
	check.call(reread.unlocked_level == 5 and reread.level_record(1)["best_time"] == 4, "Formato migrado relê sem perder progresso")
	check.call(reread.current_level == 1, "Rejogar fase antiga mantém o próximo passo separado do maior desbloqueio")
	legacy.set_value("progress", "current_level", 999)
	legacy.save(legacy_path)
	reread.load_profile(legacy_path)
	check.call(reread.current_level == 5, "Save com ponto de continuação fora do limite não abre fase bloqueada")
	legacy.set_value("preferences", "music_volume", -20)
	legacy.set_value("preferences", "effects_volume", 200)
	legacy.set_value("preferences", "vibration", false)
	legacy.save(legacy_path)
	reread.load_profile(legacy_path)
	check.call(reread.music_volume == 0 and reread.effects_volume == 1 and not reread.vibration_enabled, "Volumes fora do intervalo são limitados sem alterar a opção de vibração")
	legacy.set_value("preferences", "music_volume", "alto")
	legacy.set_value("preferences", "effects_volume", [])
	legacy.save(legacy_path)
	reread.load_profile(legacy_path)
	check.call(reread.music_volume == 1 and reread.effects_volume == 1 and reread.unlocked_level == 5, "Volumes inválidos usam valores seguros sem perder o progresso")
	check.call(Profile.format_time(59.96) == "01:00,0" and Profile.format_time(-1) == "—", "Tempo formatado não exibe segundos iguais a 60")
	_test_interrupted_saves(directory, check)
	print("Perfis: recordes, migração, persistência e recuperação verificados.")


func _test_interrupted_saves(directory: String, check: Callable) -> void:
	var path := directory + "/interrupted.cfg"
	var profile := Profile.new()
	profile.record_win(1, 1000, 3, 2)
	check.call(profile.save_profile(path) == OK, "Fixture de interrupção salva")
	var primary := FileAccess.get_file_as_bytes(path)
	var pending := FileAccess.open(path + ".tmp", FileAccess.WRITE)
	pending.store_string("[progress]\nunlocked_level=23\n")
	pending.close()
	var restored := Profile.new()
	check.call(restored.load_profile(path) == OK and restored.unlocked_level == 1, "Temporário interrompido nunca substitui o save válido na leitura")
	# Uma pasta no destino de backup simula falha de cópia sem alterar permissões do usuário.
	DirAccess.make_dir_absolute(path + ".bak")
	profile.record_win(2, 1000, 3, 2)
	# O erro nativo desta cópia é intencional e será conferido pelo retorno.
	var printed_errors := Engine.print_error_messages
	Engine.print_error_messages = false
	var blocked_error := profile.save_profile(path)
	Engine.print_error_messages = printed_errors
	check.call(blocked_error != OK, "Falha ao criar backup impede promoção do novo save")
	check.call(FileAccess.get_file_as_bytes(path) == primary, "Falha de backup preserva byte a byte o save anterior")
	DirAccess.remove_absolute(path + ".bak")
	check.call(profile.save_profile(path) == OK, "Gravação pode ser repetida depois de remover o bloqueio")
	check.call(restored.load_profile(path) == OK and restored.unlocked_level == 2, "Nova gravação recupera progresso sem corromper o perfil")
	var backup := FileAccess.get_file_as_bytes(path + ".bak")
	FileAccess.open(path, FileAccess.WRITE).store_string("[invalid]\nbroken=true\n")
	check.call(restored.load_profile(path) == OK and restored.loaded_from_backup, "Perfil interrompido é recuperado pelo backup")
	check.call(restored.save_profile(path) == OK and FileAccess.get_file_as_bytes(path + ".bak") == backup, "Recuperar não sobrescreve o backup saudável com o principal inválido")
	var restored_primary := FileAccess.get_file_as_bytes(path)
	DirAccess.make_dir_absolute(path + ".tmp")
	check.call(restored.save_profile(path) != OK, "Falha de gravação do temporário é reportada")
	check.call(FileAccess.get_file_as_bytes(path) == restored_primary and FileAccess.get_file_as_bytes(path + ".bak") == backup, "Falha de gravação preserva principal e backup")
	DirAccess.remove_absolute(path + ".tmp")
